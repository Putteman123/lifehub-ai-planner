            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Max antal poster, standard 50"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
